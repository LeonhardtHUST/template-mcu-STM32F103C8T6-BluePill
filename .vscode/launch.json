{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (OpenOCD / ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/.pio/build/genericSTM32F103C8/firmware.elf",
      "device": "STM32F103C8",
      "servertype": "openocd",
      "serverpath": "${env:HOME}/.platformio/packages/tool-openocd/bin/openocd",
      "configFiles": [
        "${workspaceFolder}/scripts/openocd-stlink.cfg"
      ],
      "svdFile": "${env:HOME}/.platformio/platforms/ststm32/misc/svd/STM32F103xx.svd",
      "runToEntryPoint": "main",
      "preLaunchTask": {
        "type": "PlatformIO",
        "task": "Pre-Debug"
      },
      "armToolchainPath": "${env:HOME}/.platformio/packages/toolchain-gccarmnoneeabi/bin",
      "searchDir": [
        "${env:HOME}/.platformio/packages/tool-openocd/openocd/scripts"
      ],
      "windows": {
        "serverpath": "${env:USERPROFILE}/.platformio/packages/tool-openocd/bin/openocd.exe",
        "armToolchainPath": "${env:USERPROFILE}/.platformio/packages/toolchain-gccarmnoneeabi/bin",
        "searchDir": [
          "${env:USERPROFILE}/.platformio/packages/tool-openocd/openocd/scripts"
        ],
        "svdFile": "${env:USERPROFILE}/.platformio/platforms/ststm32/misc/svd/STM32F103xx.svd"
      }
    },
    {
      "name": "Attach (OpenOCD / ST-Link)",
      "type": "cortex-debug",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/.pio/build/genericSTM32F103C8/firmware.elf",
      "device": "STM32F103C8",
      "servertype": "openocd",
      "serverpath": "${env:HOME}/.platformio/packages/tool-openocd/bin/openocd",
      "configFiles": [
        "${workspaceFolder}/scripts/openocd-stlink.cfg"
      ],
      "svdFile": "${env:HOME}/.platformio/platforms/ststm32/misc/svd/STM32F103xx.svd",
      "armToolchainPath": "${env:HOME}/.platformio/packages/toolchain-gccarmnoneeabi/bin",
      "searchDir": [
        "${env:HOME}/.platformio/packages/tool-openocd/openocd/scripts"
      ],
      "windows": {
        "serverpath": "${env:USERPROFILE}/.platformio/packages/tool-openocd/bin/openocd.exe",
        "armToolchainPath": "${env:USERPROFILE}/.platformio/packages/toolchain-gccarmnoneeabi/bin",
        "searchDir": [
          "${env:USERPROFILE}/.platformio/packages/tool-openocd/openocd/scripts"
        ],
        "svdFile": "${env:USERPROFILE}/.platformio/platforms/ststm32/misc/svd/STM32F103xx.svd"
      }
    }
  ]
}
